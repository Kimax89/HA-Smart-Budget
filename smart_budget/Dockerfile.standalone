# Standalone build: exposed only on localhost by compose.yaml.
FROM node:24.22.3-alpine3.24
RUN apk add --no-cache su-exec
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8099 DATA_DIR=/data
COPY package.json ./
COPY src ./src
COPY public ./public
RUN mkdir -p /data && chown node:node /data
USER node
COPY container-entrypoint.sh /usr/local/bin/budget-entrypoint
RUN chmod 755 /usr/local/bin/budget-entrypoint
ENTRYPOINT ["budget-entrypoint"]
EXPOSE 8099
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD node -e "fetch('http://127.0.0.1:8099/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "src/server.js"]
